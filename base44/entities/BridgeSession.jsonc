{
  "name": "BridgeSession",
  "type": "object",
  "properties": {
    "tunnel_url": {
      "type": "string",
      "title": "Tunnel URL",
      "description": "Live tunnel endpoint linking to the user's Unity editor"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "disconnected",
        "connecting",
        "connected",
        "unreachable",
        "error"
      ],
      "default": "disconnected"
    },
    "pair_token": {
      "type": "string",
      "title": "Pair Token",
      "description": "Secret token the local tunnel launcher uses to auto-announce its current tunnel URL"
    },
    "unity_version": {
      "type": "string",
      "title": "Unity Version"
    },
    "project_name": {
      "type": "string",
      "title": "Project Name",
      "description": "Name of the Unity project reported by the bridge /health endpoint"
    },
    "unity_engine": {
      "type": "string",
      "title": "Unity Engine Flag",
      "description": "unity_connected from /health. unknown when the bridge does not report engine flags.",
      "enum": [
        "unknown",
        "connected",
        "disconnected"
      ],
      "default": "unknown"
    },
    "blender_engine": {
      "type": "string",
      "title": "Blender Engine Flag",
      "description": "blender_connected from /health. unknown when the bridge does not report engine flags \u2014 never treated as failed.",
      "enum": [
        "unknown",
        "connected",
        "disconnected"
      ],
      "default": "unknown"
    },
    "blender_addr": {
      "type": "string",
      "title": "Blender Address",
      "description": "Local Blender MCP addon address reported by /health (e.g. 127.0.0.1:9877)"
    },
    "last_seen_at": {
      "type": "string",
      "title": "Last Seen At",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "rls": {
    "create": true,
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  },
  "required": []
}