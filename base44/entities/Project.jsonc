{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Project name"
    },
    "engine": {
      "type": "string",
      "title": "Engine",
      "enum": [
        "Unity 2021.6",
        "Unity 6"
      ],
      "default": "Unity 6"
    },
    "framework": {
      "type": "string",
      "title": "Framework",
      "enum": [
        "UFE2",
        "Custom"
      ],
      "default": "UFE2"
    },
    "platform": {
      "type": "string",
      "title": "Target Platform",
      "description": "e.g. PC/Steam, Mobile, Console"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "Project description (long text)"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}