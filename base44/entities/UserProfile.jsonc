{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string",
      "title": "Display Name",
      "description": "Name shown across the app"
    },
    "groq_api_key": {
      "type": "string",
      "title": "Groq API Key",
      "description": "The user's own Groq API key. Used for their chat and council calls so each person draws on their own Groq quota."
    },
    "meshy_api_key": {
      "type": "string",
      "title": "Meshy API Key",
      "description": "The user's own Meshy AI API key, used for 3D character generation and rigging."
    },
    "preferences": {
      "type": "object",
      "title": "Preferences",
      "description": "User-specific app preferences (JSON)"
    },
    "onboarded": {
      "type": "boolean",
      "title": "Onboarded",
      "default": false
    }
  },
  "rls": {
    "create": true,
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  },
  "required": []
}